{
  "name": "eventhub-perf",
  "version": "1.0.0",
  "private": true,
  "description": "EventHub-Variante mit eingebauten Performance-Problemen (Lab 13.1).",
  "scripts": {
    "ng": "ng",
    "hero": "node scripts/generate-hero.mjs --width 2400 --height 1200 --noise 5",
    "prestart": "npm run hero",
    "start": "ng serve --port 4300",
    "prebuild": "npm run hero",
    "build": "ng build",
    "build:stats": "npm run hero && ng build --stats-json",
    "serve:dist": "serve -s dist/eventhub-perf/browser -l 8081"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "chart.js": "^4.6.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "serve": "^14.2.6",
    "typescript": "~6.0.2"
  }
}
