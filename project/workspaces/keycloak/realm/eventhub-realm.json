{
  "realm": "eventhub",
  "displayName": "EventHub (Kurs)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "admin", "description": "EventHub-Administration" },
      { "name": "user", "description": "Angemeldete Teilnehmende" }
    ]
  },
  "clients": [
    {
      "clientId": "eventhub-spa",
      "name": "EventHub SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:4200/*", "http://localhost:4201/*", "http://localhost:4202/*"],
      "webOrigins": ["http://localhost:4200", "http://localhost:4201", "http://localhost:4202"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "realm roles as roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@eventhub.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "alice123", "temporary": false }],
      "realmRoles": ["admin", "user"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@eventhub.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "bob123", "temporary": false }],
      "realmRoles": ["user"]
    }
  ]
}
