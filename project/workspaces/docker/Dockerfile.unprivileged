# syntax=docker/dockerfile:1
# Variante ohne root: nginx läuft als Benutzer 101 (Image nginxinc/nginx-unprivileged).
#   cd workspaces
#   docker build -f docker/Dockerfile.unprivileged -t eventhub-web:nonroot .

FROM node:24-alpine AS build
ARG APP_DIR=eventhub-perf-fixed
WORKDIR /app
COPY ${APP_DIR}/package.json ${APP_DIR}/package-lock.json ./
RUN npm ci
COPY ${APP_DIR}/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine AS runtime
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/runtime/config.template.json /etc/eventhub/config.template.json
COPY --chmod=755 docker/runtime/40-eventhub-config.sh /docker-entrypoint.d/40-eventhub-config.sh
# Benutzer 101 muss config.json beim Start überschreiben dürfen: Dateien gehören ihm
# (config.json existiert schon aus public/, deshalb reicht Schreibrecht auf die Datei)
COPY --chown=101:101 --from=build /app/dist/eventhub-perf/browser /usr/share/nginx/html
ENV API_URL=http://localhost:3000
EXPOSE 8080
USER 101
